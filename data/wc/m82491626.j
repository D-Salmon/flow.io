{"ok":true,"module":"io/drivers/ds18b20","docs":{"io/drivers/ds18b20/poll_ms":{"type":"Int32","label_t":"cfgdocs.io.drivers.ds18b20.poll_ms.label","help_t":"cfgdocs.io.drivers.ds18b20.poll_ms.help","unit":"ms","label":"Période lecture DS18B20 (ms)","label_i18n":"cfgdocs.io.drivers.ds18b20.poll_ms.label","help":"Intervalle entre deux lectures des sondes DS18B20.","help_i18n":"cfgdocs.io.drivers.ds18b20.poll_ms.help"},"io/drivers/ds18b20/transport":{"type":"UInt8","label_t":"cfgdocs.io.drivers.ds18b20.transport.label","help_t":"cfgdocs.io.drivers.ds18b20.transport.help","enum_set":"ds18b20_transport","label":"Raccordement des températures","label_i18n":"cfgdocs.io.drivers.ds18b20.transport.label","help":"Choisit le raccordement commun des deux sondes DS18B20. Les entrées directes utilisent GPIO20 pour l'eau et GPIO19 pour l'air; Qwiic utilise un seul pont DS2484 à l'adresse I²C fixe 0x18. Le bus Qwiic reste actif pour les autres composants. Redémarrage requis.","help_i18n":"cfgdocs.io.drivers.ds18b20.transport.help"}},"meta":{}}