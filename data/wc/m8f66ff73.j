{"ok":true,"module":"poollogic/devices","docs":{"poollogic/devices/dis_pump_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.devices.dis_pump_slot.label","help_t":"cfgdocs.poollogic.devices.dis_pump_slot.help","enum_set":"poollogic_device_slot","label":"Désinfection","label_i18n":"cfgdocs.poollogic.devices.dis_pump_slot.label","help":"Choisissez le relais qui commande la désinfection : pompe doseuse de chlore ou d'oxygène actif, ou électrolyseur selon le traitement sélectionné.","help_i18n":"cfgdocs.poollogic.devices.dis_pump_slot.help"},"poollogic/devices/fill_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.devices.fill_slot.label","help_t":"cfgdocs.poollogic.devices.fill_slot.help","enum_set":"poollogic_device_slot","label":"Slot remplissage","label_i18n":"cfgdocs.poollogic.devices.fill_slot.label","help":"Choisissez le relais qui commande la pompe ou l'électrovanne de remplissage du bassin.","help_i18n":"cfgdocs.poollogic.devices.fill_slot.help"},"poollogic/devices/filtr_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.devices.filtr_slot.label","help_t":"cfgdocs.poollogic.devices.filtr_slot.help","enum_set":"poollogic_device_slot","label":"Slot filtration","label_i18n":"cfgdocs.poollogic.devices.filtr_slot.label","help":"Choisissez le relais qui commande le contacteur de la pompe de filtration.","help_i18n":"cfgdocs.poollogic.devices.filtr_slot.help"},"poollogic/devices/heater_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.devices.heater_slot.label","help_t":"cfgdocs.poollogic.devices.heater_slot.help","enum_set":"poollogic_device_slot","label":"Slot chauffage","label_i18n":"cfgdocs.poollogic.devices.heater_slot.label","help":"Choisissez le relais qui autorise le chauffage de l'eau.","help_i18n":"cfgdocs.poollogic.devices.heater_slot.help"},"poollogic/devices/lights_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.devices.lights_slot.label","help_t":"cfgdocs.poollogic.devices.lights_slot.help","enum_set":"poollogic_device_slot","label":"Slot éclairage","label_i18n":"cfgdocs.poollogic.devices.lights_slot.label","help":"Choisissez le relais qui commande l'éclairage du bassin.","help_i18n":"cfgdocs.poollogic.devices.lights_slot.help"},"poollogic/devices/ph_pump_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.devices.ph_pump_slot.label","help_t":"cfgdocs.poollogic.devices.ph_pump_slot.help","enum_set":"poollogic_device_slot","label":"Slot pompe pH","label_i18n":"cfgdocs.poollogic.devices.ph_pump_slot.label","help":"Choisissez le relais qui commande la pompe doseuse de correction du pH.","help_i18n":"cfgdocs.poollogic.devices.ph_pump_slot.help"},"poollogic/devices/robot_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.devices.robot_slot.label","help_t":"cfgdocs.poollogic.devices.robot_slot.help","enum_set":"poollogic_device_slot","label":"Slot robot","label_i18n":"cfgdocs.poollogic.devices.robot_slot.label","help":"Choisissez le relais qui commande l'alimentation du robot de nettoyage.","help_i18n":"cfgdocs.poollogic.devices.robot_slot.help"},"poollogic/devices/swg_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.devices.swg_slot.label","help_t":"cfgdocs.poollogic.devices.swg_slot.help","enum_set":"poollogic_device_slot","label":"Slot electrolyse","label_i18n":"cfgdocs.poollogic.devices.swg_slot.label","help":"Numéro de slot PDM associé à l'electrolyseur.","help_i18n":"cfgdocs.poollogic.devices.swg_slot.help"}},"meta":{}}