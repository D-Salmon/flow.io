{"ok":true,"module":"ethernet","docs":{"ethernet/dhcp":{"type":"Bool","label_t":"cfgdocs.ethernet.dhcp.label","help_t":"cfgdocs.ethernet.dhcp.help","label":"Configuration automatique (DHCP)","label_i18n":"cfgdocs.ethernet.dhcp.label","help":"Activé : l'adresse réseau est fournie automatiquement par le routeur. Désactivé : les paramètres IPv4 fixes ci-dessous sont utilisés.","help_i18n":"cfgdocs.ethernet.dhcp.help"},"ethernet/dns1":{"type":"CharArray","label_t":"cfgdocs.ethernet.dns1.label","help_t":"cfgdocs.ethernet.dns1.help","label":"DNS Ethernet principal","label_i18n":"cfgdocs.ethernet.dns1.label","help":"Serveur DNS principal. Vide : la passerelle est utilisée.","help_i18n":"cfgdocs.ethernet.dns1.help"},"ethernet/dns2":{"type":"CharArray","label_t":"cfgdocs.ethernet.dns2.label","help_t":"cfgdocs.ethernet.dns2.help","label":"DNS Ethernet secondaire","label_i18n":"cfgdocs.ethernet.dns2.label","help":"Serveur DNS secondaire facultatif.","help_i18n":"cfgdocs.ethernet.dns2.help"},"ethernet/enabled":{"type":"Bool","label_t":"cfgdocs.ethernet.enabled.label","help_t":"cfgdocs.ethernet.enabled.help","label":"Ethernet activé","label_i18n":"cfgdocs.ethernet.enabled.label","help":"Active ou désactive l'interface Ethernet W5500. Quand Ethernet est actif, il est prioritaire; le WiFi station puis le portail AP servent de fallback si Ethernet n'obtient pas d'IP.","help_i18n":"cfgdocs.ethernet.enabled.help"},"ethernet/gateway":{"type":"CharArray","label_t":"cfgdocs.ethernet.gateway.label","help_t":"cfgdocs.ethernet.gateway.help","label":"Passerelle Ethernet","label_i18n":"cfgdocs.ethernet.gateway.label","help":"Adresse IPv4 du routeur utilisée comme passerelle.","help_i18n":"cfgdocs.ethernet.gateway.help"},"ethernet/ip":{"type":"CharArray","label_t":"cfgdocs.ethernet.ip.label","help_t":"cfgdocs.ethernet.ip.help","label":"Adresse IP Ethernet","label_i18n":"cfgdocs.ethernet.ip.label","help":"Adresse IPv4 fixe du Waveshare, utilisée uniquement quand DHCP est désactivé.","help_i18n":"cfgdocs.ethernet.ip.help"},"ethernet/subnet":{"type":"CharArray","label_t":"cfgdocs.ethernet.subnet.label","help_t":"cfgdocs.ethernet.subnet.help","label":"Masque de sous-réseau Ethernet","label_i18n":"cfgdocs.ethernet.subnet.label","help":"Masque IPv4 associé à l'adresse fixe, par exemple 255.255.255.0.","help_i18n":"cfgdocs.ethernet.subnet.help"}},"meta":{}}