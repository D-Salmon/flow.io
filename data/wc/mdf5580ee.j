{"ok":true,"module":"ethernet","docs":{"ethernet/enabled":{"type":"Bool","label_t":"cfgdocs.ethernet.enabled.label","help_t":"cfgdocs.ethernet.enabled.help","label":"Ethernet activé","label_i18n":"cfgdocs.ethernet.enabled.label","help":"Active ou désactive l'interface Ethernet W5500. Quand Ethernet est actif, le réseau station et le provisioning AP restent désactivés.","help_i18n":"cfgdocs.ethernet.enabled.help"}},"meta":{}}