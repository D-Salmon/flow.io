{"ok":true,"module":"webinterface","docs":{"webinterface/authentication_required":{"type":"Bool","label_t":"cfgdocs.webinterface.authentication_required.label","help_t":"cfgdocs.webinterface.authentication_required.help","label":"Exiger l’authentification Web","label_i18n":"cfgdocs.webinterface.authentication_required.label","help":"Si activé, l’interface Web exige un compte dès son ouverture. Si désactivé, elle s’ouvre par défaut en Opérateur local et l’administrateur s’identifie seulement pour les réglages sensibles.","help_i18n":"cfgdocs.webinterface.authentication_required.help"}},"meta":{}}