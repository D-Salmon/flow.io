{"ok":true,"module":"poollogic/mode","docs":{"poollogic/mode/auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.mode.auto_mode.label","help_t":"cfgdocs.poollogic.mode.auto_mode.help","label":"Mode auto global","label_i18n":"cfgdocs.poollogic.mode.auto_mode.label","help":"Active le pilotage automatique global de la piscine.","help_i18n":"cfgdocs.poollogic.mode.auto_mode.help"},"poollogic/mode/disinfection_type":{"type":"UInt8","label_t":"cfgdocs.poollogic.mode.disinfection_type.label","help_t":"cfgdocs.poollogic.mode.disinfection_type.help","enum_set":"poollogic_disinfection_type","label":"Type de désinfection","label_i18n":"cfgdocs.poollogic.mode.disinfection_type.label","help":"Choisit la stratégie de désinfection principale.","help_i18n":"cfgdocs.poollogic.mode.disinfection_type.help"},"poollogic/mode/enabled":{"type":"Bool","label_t":"cfgdocs.poollogic.mode.enabled.label","help_t":"cfgdocs.poollogic.mode.enabled.help","label":"PoolLogic actif","label_i18n":"cfgdocs.poollogic.mode.enabled.label","help":"Active ou désactive les automatismes PoolLogic.","help_i18n":"cfgdocs.poollogic.mode.enabled.help"},"poollogic/mode/heater_auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.mode.heater_auto_mode.label","help_t":"cfgdocs.poollogic.mode.heater_auto_mode.help","label":"Mode auto chauffage","label_i18n":"cfgdocs.poollogic.mode.heater_auto_mode.label","help":"Active la régulation automatique de la température d'eau via le chauffage.","help_i18n":"cfgdocs.poollogic.mode.heater_auto_mode.help"},"poollogic/mode/orp_auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.mode.orp_auto_mode.label","help_t":"cfgdocs.poollogic.mode.orp_auto_mode.help","label":"Mode auto ORP","label_i18n":"cfgdocs.poollogic.mode.orp_auto_mode.label","help":"Active la régulation automatique ORP/chlore.","help_i18n":"cfgdocs.poollogic.mode.orp_auto_mode.help"},"poollogic/mode/ph_auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.mode.ph_auto_mode.label","help_t":"cfgdocs.poollogic.mod