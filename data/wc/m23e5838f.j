{"ok":true,"module":"poollogic/sensors","docs":{"poollogic/sensors/air_temp_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.air_temp_io_id.label","help_t":"cfgdocs.poollogic.sensors.air_temp_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO température air","label_i18n":"cfgdocs.poollogic.sensors.air_temp_io_id.label","help":"Identifiant IO de la sonde température air.","help_i18n":"cfgdocs.poollogic.sensors.air_temp_io_id.help"},"poollogic/sensors/chl_lvl_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.chl_lvl_io_id.label","help_t":"cfgdocs.poollogic.sensors.chl_lvl_io_id.help","enum_set":"flowio_logical_input_digital","label":"IO niveau cuve chlore","label_i18n":"cfgdocs.poollogic.sensors.chl_lvl_io_id.label","help":"Identifiant IO de l'entrée digitale niveau bas cuve chlore.","help_i18n":"cfgdocs.poollogic.sensors.chl_lvl_io_id.help"},"poollogic/sensors/dis_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.dis_io_id.label","help_t":"cfgdocs.poollogic.sensors.dis_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO capteur ORP","label_i18n":"cfgdocs.poollogic.sensors.dis_io_id.label","help":"Identifiant IO de la mesure ORP.","help_i18n":"cfgdocs.poollogic.sensors.dis_io_id.help"},"poollogic/sensors/filtr_fb_active_high":{"type":"Bool","label_t":"cfgdocs.poollogic.sensors.filtr_fb_active_high.label","help_t":"cfgdocs.poollogic.sensors.filtr_fb_active_high.help","label":"État actif du retour filtration","label_i18n":"cfgdocs.poollogic.sensors.filtr_fb_active_high.label","help":"Choisissez l'état du contact auxiliaire qui indique que le contacteur de filtration est réellement enclenché.","help_i18n":"cfgdocs.poollogic.sensors.filtr_fb_active_high.help"},"poollogic/sensors/filtr_fb_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.filtr_fb_io_id.label","help_t":"cfgdocs.poollogic.sensors.filtr_fb_io_id.help","label":"Retour contacteur filtration","label_i18n":"cfgdocs.poollogic.sensors.filtr_fb_io_id.label","help":"Entrée numérique du contact auxiliaire du contacteur de filtration. La valeur 65535 désactive cette surveillance.","help_i18n":"cfgdocs.poollogic.sensors.filtr_fb_io_id.help"},"poollogic/sensors/ph_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.ph_io_id.label","help_t":"cfgdocs.poollogic.sensors.ph_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO capteur pH","label_i18n":"cfgdocs.poollogic.sensors.ph_io_id.label","help":"Identifiant IO de la mesure pH.","help_i18n":"cfgdocs.poollogic.sensors.ph_io_id.help"},"poollogic/sensors/ph_lvl_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.ph_lvl_io_id.label","help_t":"cfgdocs.poollogic.sensors.ph_lvl_io_id.help","enum_set":"flowio_logical_input_digital","label":"IO niveau cuve pH","label_i18n":"cfgdocs.poollogic.sensors.ph_lvl_io_id.label","help":"Identifiant IO de l'entrée digitale niveau bas cuve pH.","help_i18n":"cfgdocs.poollogic.sensors.ph_lvl_io_id.help"},"poollogic/sensors/pool_lvl_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.pool_lvl_io_id.label","help_t":"cfgdocs.poollogic.sensors.pool_lvl_io_id.help","enum_set":"flowio_logical_input_digital","label":"IO niveau bassin","label_i18n":"cfgdocs.poollogic.sensors.pool_lvl_io_id.label","help":"Identifiant IO de la mesure de niveau bassin.","help_i18n":"cfgdocs.poollogic.sensors.pool_lvl_io_id.help"},"poollogic/sensors/psi_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.psi_io_id.label","help_t":"cfgdocs.poollogic.sensors.psi_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO pression","label_i18n":"cfgdocs.poollogic.sensors.psi_io_id.label","help":"Identifiant IO du capteur de pression.","help_i18n":"cfgdocs.poollogic.sensors.psi_io_id.help"},"poollogic/sensors/psi_monitoring":{"type":"Bool","label_t":"cfgdocs.poollogic.sensors.psi_monitoring.label","help_t":"cfgdocs.poollogic.sensors.psi_monitoring.help","label":"Surveillance pression","label_i18n":"cfgdocs.poollogic.sensors.psi_monitoring.label","help":"Active les alarmes de pression basse et haute ainsi que l'arrêt de sécurité de la filtration. Désactivez si aucun capteur de pression n'est installé.","help_i18n":"cfgdocs.poollogic.sensors.psi_monitoring.help"},"poollogic/sensors/swg_fb_active_high":{"type":"Bool","label_t":"cfgdocs.poollogic.sensors.swg_fb_active_high.label","help_t":"cfgdocs.poollogic.sensors.swg_fb_active_high.help","label":"État actif du retour électrolyseur","label_i18n":"cfgdocs.poollogic.sensors.swg_fb_active_high.label","help":"Choisissez l'état du contact auxiliaire qui indique que le contacteur de l'électrolyseur est réellement enclenché.","help_i18n":"cfgdocs.poollogic.sensors.swg_fb_active_high.help"},"poollogic/sensors/swg_fb_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.swg_fb_io_id.label","help_t":"cfgdocs.poollogic.sensors.swg_fb_io_id.help","label":"Retour contacteur électrolyseur","label_i18n":"cfgdocs.poollogic.sensors.swg_fb_io_id.label","help":"Entrée numérique du contact auxiliaire du contacteur d'électrolyse. La valeur 65535 désactive cette surveillance.","help_i18n":"cfgdocs.poollogic.sensors.swg_fb_io_id.help"},"poollogic/sensors/wat_temp_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.wat_temp_io_id.label","help_t":"cfgdocs.poollogic.sensors.wat_temp_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO température eau","label_i18n":"cfgdocs.poollogic.sensors.wat_temp_io_id.label","help":"Identifiant IO de la sonde température eau.","help_i18n":"cfgdocs.poollogic.sensors.wat_temp_io_id.help"}},"meta":{}}