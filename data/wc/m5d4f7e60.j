{"ok":true,"module":"hmi/buzzer","docs":{"hmi/buzzer/alarm_sound":{"type":"Bool","label_t":"cfgdocs.hmi.buzzer.alarm_sound.label","help_t":"cfgdocs.hmi.buzzer.alarm_sound.help","label":"Son des alarmes","label_i18n":"cfgdocs.hmi.buzzer.alarm_sound.label","help":"Active les notifications sonores pour les alarmes de niveau Alarme ou Critique. Les avertissements de diagnostic restent silencieux.","help_i18n":"cfgdocs.hmi.buzzer.alarm_sound.help"},"hmi/buzzer/enable":{"type":"Bool","label_t":"cfgdocs.hmi.buzzer.enable.label","help_t":"cfgdocs.hmi.buzzer.enable.help","label":"Buzzer actif","label_i18n":"cfgdocs.hmi.buzzer.enable.label","help":"Active le bip local de validation après application d'une configuration dans le ConfigStore.","help_i18n":"cfgdocs.hmi.buzzer.enable.help"},"hmi/buzzer":{}},"meta":{}}