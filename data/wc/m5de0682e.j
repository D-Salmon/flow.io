{"ok":true,"module":"io/drivers/ads1115_int","docs":{"io/drivers/ads1115_int/address":{"type":"UInt8","label_t":"cfgdocs.io.drivers.ads1115_int.address.label","help_t":"cfgdocs.io.drivers.ads1115_int.address.help","display_format":"hex","label":"Carte pH / ORP — adresse I²C","label_i18n":"cfgdocs.io.drivers.ads1115_int.address.label","help":"Adresse I²C de la carte pH/ORP obligatoire. ORP utilise le canal A0 et pH le canal A1. Le second ADS1115 prend automatiquement l'autre adresse entre 0x48 et 0x49. Redémarrage requis.","help_i18n":"cfgdocs.io.drivers.ads1115_int.address.help"}},"meta":{}}