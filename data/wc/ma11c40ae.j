{"ok":true,"module":"poollogic/safety","docs":{"poollogic/safety/flow_start_dly_s":{"type":"UInt8","label_t":"cfgdocs.poollogic.safety.flow_start_dly_s.label","help_t":"cfgdocs.poollogic.safety.flow_start_dly_s.help","unit":"s","label":"Délai de contrôle du débit (s)","label_i18n":"cfgdocs.poollogic.safety.flow_start_dly_s.label","help":"Temps laissé à la pompe pour établir le débit avant déclenchement de la sécurité DIN5.","help_i18n":"cfgdocs.poollogic.safety.flow_start_dly_s.help"},"poollogic/safety/freeze_hold_t":{"type":"Float","label_t":"cfgdocs.poollogic.safety.freeze_hold_t.label","help_t":"cfgdocs.poollogic.safety.freeze_hold_t.help","unit":"C","label":"Seuil maintien hors gel (C)","label_i18n":"cfgdocs.poollogic.safety.freeze_hold_t.label","help":"Temperature de maintien pour la protection hors gel.","help_i18n":"cfgdocs.poollogic.safety.freeze_hold_t.help"},"poollogic/safety/psi_high_th":{"type":"Float","label_t":"cfgdocs.poollogic.safety.psi_high_th.label","help_t":"cfgdocs.poollogic.safety.psi_high_th.help","unit":"bar","label":"Seuil pression haute","label_i18n":"cfgdocs.poollogic.safety.psi_high_th.label","help":"Seuil de pression haute pour detection d'anomalie.","help_i18n":"cfgdocs.poollogic.safety.psi_high_th.help"},"poollogic/safety/psi_low_th":{"type":"Float","label_t":"cfgdocs.poollogic.safety.psi_low_th.label","help_t":"cfgdocs.poollogic.safety.psi_low_th.help","unit":"bar","label":"Seuil pression basse","label_i18n":"cfgdocs.poollogic.safety.psi_low_th.label","help":"Seuil de pression basse pour detection d'anomalie.","help_i18n":"cfgdocs.poollogic.safety.psi_low_th.help"},"poollogic/safety/psi_start_dly_s":{"type":"UInt8","label_t":"cfgdocs.poollogic.safety.psi_start_dly_s.label","help_t":"cfgdocs.poollogic.safety.psi_start_dly_s.help","unit":"s","label":"Délai démarrage pression (s)","label_i18n":"cfgdocs.poollogic.safety.psi_start_dly_s.label","help":"Temps d'attente avant vérification pression après démarrage.","help_i18n":"cfgdocs.poollo